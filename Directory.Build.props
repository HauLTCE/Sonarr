<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Without this, `new CultureInfo("en-US")` throws under InvariantGlobalization, and
         Discord.Net does exactly that for every guild's PreferredLocale — which killed every
         GUILD_AVAILABLE dispatch at cutover (guilds never populated). Setting this to false
         makes culture creation succeed backed by invariant data instead of throwing. We never
         format anything with a guild's locale, so invariant data is the right answer anyway;
         the alternative is apt-installing libicu into the image for strings we don't use. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Warnings-as-errors on the engine: it is pure logic with a determinism contract,
       so sloppiness there is a correctness bug (checklist Phase 0). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sonarr.Elaine'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
