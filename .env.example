# SONARR bot — environment template
# Copy to .env and fill in real values. .env is gitignored; NEVER commit it.

# --- Bot runtime ---
DISCORD_TOKEN=your-discord-bot-token
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
MIDDAY_BREAK_ENABLED=False
SLEEP_MODE_ENABLED=False

# --- Deploy / admin scripts (deploy.py, boost_player.py) ---
# Used only by the local SSH deploy tooling, not by the bot itself.
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PASSWORD=
DEPLOY_PORT=22
DEPLOY_REMOTE_DIR=/root/sonarr/
BOOST_TARGET_USER_ID=
