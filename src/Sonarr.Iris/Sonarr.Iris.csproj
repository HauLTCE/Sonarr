<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The binary a person types, not the module name. `sonarr stats` is what the operator
         runs, and a shim that has to translate the name is a shim that drifts. The module is
         Iris: the CLI plus the logging the bot writes through (Logging/). -->
    <AssemblyName>sonarr</AssemblyName>
    <RootNamespace>Sonarr.Iris</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application for FeatureGate: a toggle written straight into core.feature_flag would
         skip the Redis invalidation that makes the change apply immediately in the running
         bot. Reusing the service means the CLI and /feature cannot disagree. -->
    <ProjectReference Include="..\Sonarr.Application\Sonarr.Application.csproj" />
    <ProjectReference Include="..\Sonarr.Infrastructure\Sonarr.Infrastructure.csproj" />
    <ProjectReference Include="..\Sonarr.Domain\Sonarr.Domain.csproj" />
    <!-- PersonaLoader for `sonarr persona`: the same validation the bot runs at boot, so the
         report and the refusal it predicts cannot disagree. -->
    <ProjectReference Include="..\Sonarr.Elaine\Sonarr.Elaine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting for the configuration builder and DI. No Discord.Net: the CLI never
         connects to the gateway, which is exactly why it cannot write config keys that need
         a channel/role lookup (see Help). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Serilog: Iris owns the shared logging (Logging/IrisLogging) that the bot's host
         registers and that `sonarr logs` reads back. The bot gets these transitively through
         its ProjectReference here. -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The commands are internal — the binary's surface is its verbs — but their report-shaping
       helpers are the part worth unit testing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sonarr.Iris.Tests" />
  </ItemGroup>

</Project>
