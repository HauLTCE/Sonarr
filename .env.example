# ─────────────────────────────────────────────────────────────────────────────
# Sonarr (.NET 10) — environment template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Secrets NEVER get committed — not in code, not in docs,
# not in compose files.
#
# The prod `.env` is part of the backup set (weekly `config-` snapshot into
# /root/backups/sonarr/YYYY/MM/, docs/11-deployment.md) precisely because it holds
# the only copy of these secrets. Treat that backup tree as sensitive.
#
# Config is validated at boot; the process fails loudly on bad config.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Dev only: register slash commands to this guild for instant updates.
# Leave EMPTY in prod = global registration (docs/07-commands.md).
DISCORD_DEV_GUILD_ID=

# ── Music (Lavalink 4.2.2 — pre-existing host install, never managed by compose) ──
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=

# ── Postgres ─────────────────────────────────────────────────────────────────
# These three are consumed by docker-compose to initialise the container.
POSTGRES_DB=sonarr
POSTGRES_USER=sonarr
# Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
# ...and this is what the bot connects with — keep it consistent with the three above.
# Dev (bot on host, DB in compose) and prod (network_mode: host) are both loopback.
PG_CONNECTION=Host=127.0.0.1;Port=5432;Database=sonarr;Username=sonarr;Password=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_CONNECTION=127.0.0.1:6379

# Dev only: host ports for the compose containers. Change these if something already
# listens there (this dev box has a native Postgres on 5432) and keep the two
# connection strings above in sync.
#POSTGRES_HOST_PORT=5432
#REDIS_HOST_PORT=6379

# ── Panels & admin ───────────────────────────────────────────────────────────
# Comma-separated Discord user IDs seeded as admins (authority stays in Postgres).
ADMIN_USER_IDS=
# Public base URL used in DM login links. Dev: http://localhost:3000
PANEL_BASE_URL=https://sonarr.hault.io.vn

# ── Paths & ports ────────────────────────────────────────────────────────────
# Container paths (prod). In dev the bot runs on the host, so point these at local
# dirs, e.g. BACKUP_PATH=./data/backups and PERSONA_PATH=./persona
BACKUP_PATH=/backups
PERSONA_PATH=/app/persona
# Embedding model for the semantic tier. Fetch it with scripts/fetch-model.sh (90MB, gitignored).
# If the files are absent she still works — matching just stays lexical-only.
MODEL_PATH=/app/models/minilm-l6-v2
API_PORT=5088

# ── deploy/deploy.sh only (never read by the bot) ─────────────────────────────
# Key-only SSH is a first-deploy task; do not put a password here.
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_REMOTE_DIR=/root/sonarr-net
# Image tags used by deploy/docker-compose.yml. Leave unset to build on the server
# (`deploy.sh --build`); set these to pull what CI published instead
# (`deploy.sh --pull`). The branch tag tracks the tip; swap it for a
# `sha-<full-sha>` tag to pin, which is also how you roll back.
# A private GHCR package needs one `docker login ghcr.io` on the server first.
# Lowercase owner on purpose: GHCR rejects an uppercase path, and metadata-action
# lowercases it for us when it tags.
#BOT_IMAGE=ghcr.io/haultce/sonarr-bot:feat-dotnet-rewrite
#WEB_IMAGE=ghcr.io/haultce/sonarr-web:feat-dotnet-rewrite
