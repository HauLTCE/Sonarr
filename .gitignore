# Environment variables & secrets (NEVER commit — Discord token, SSH/deploy password, Lavalink pw)
.env
.env.*
*.env
!.env.example
# Private keys / credential files
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
secrets.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Databases + their WAL/SHM sidecars (user data — never commit).
# The old rule only matched *.db, so chroma's .sqlite3 (and every -wal/-shm
# holding uncommitted transactions) slipped through.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
bot_data.db

# JSON data files (user / guild data)
playlists.json
levels.json
ai_memory.json
server_config.json

# One-time migration leftovers (renamed copies of the JSON data above — same content)
*.migrated

# Runtime data directory: DBs, chroma vector store, per-user context/affect state,
# training data. The bot and deploy.py create it fresh — nothing here belongs in git.
data/
docs/

# System
.DS_Store
Thumbs.db

# Logs
*.log
# Server log dumps (contain user messages/IDs — never commit)
docs/refactor-notes/_server_log_raw.txt
_server_log_raw.txt
