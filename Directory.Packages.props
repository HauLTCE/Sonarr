<Project>

  <!-- Central package management: one pinned version per package, solution-wide.
       Exact versions (not ranges) per the repo's dependency rule. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Discord + music">
    <PackageVersion Include="Discord.Net" Version="3.20.1" />
    <PackageVersion Include="Lavalink4NET.Discord.Net" Version="4.2.2" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Transitive pin: the Npgsql provider asks for Relational 10.0.4, which conflicts
         with the 10.0.10 EF Core above (MSB3277 in Sonarr.Migrator). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <ItemGroup Label="Engine + embeddings">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <!-- 1.0.3 rather than 2.0.0: BertTokenizer.Create(vocabPath) is all we need, and 2.0.0
         drags in Google.Protobuf for tokenizers we do not use. -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup Label="Hosting + logging">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- Not Serilog.AspNetCore: the bot is a plain worker host, no Kestrel. -->
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Migrator (legacy SQLite/JSON source)">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Transitive pin: Microsoft.Data.Sqlite 10.0.10 pulls SQLitePCLRaw 2.1.11, which is
         flagged NU1903 (CVE-2025-6965, SQLite < 3.50.2). 3.0.x links a patched SQLite. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.4" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.0.4" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
